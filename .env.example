PORT=3000
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Admin panel (default account created on first run if none exists)
ADMIN_EMAIL=admin@lumiere.beauty
ADMIN_PASSWORD=admin123
ADMIN_NAME=Store Admin

# M-Pesa Daraja (Safaricom). Leave ALL MPESA_* empty to simulate payments locally.
# Get keys from: https://developer.safaricom.co.ke
# NO spaces after = signs
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://YOUR-PUBLIC-DOMAIN.com/api/payments/mpesa/callback
MPESA_ENV=sandbox
# Set to true to force demo mode even when keys are present (local testing)
MPESA_SIMULATE=false

# Stripe. Leave empty to simulate card payments in development.
STRIPE_SECRET_KEY=
